# EVE PR3 B0→B2 clean pilot configuration.
# IMPORTANT: do NOT point these values at either LEGACY_EVIDENCE_NOT_BASELINE Supabase project.
# This file intentionally contains no legacy project URL/ref/anon/service-role key.

# Browser feature gate. Production must remain false until P2/P4/P3/A10 gates close.
NEXT_PUBLIC_EVE_PR3_PILOT_ENABLED=false
NEXT_PUBLIC_EVE_PR3_SUPABASE_URL=https://keqrkyumfyhfivllvdbl.supabase.co
NEXT_PUBLIC_EVE_PR3_SUPABASE_PUBLISHABLE_KEY=

# Local QA only. When true, Pr3PilotRuntimeRunner sends clean x-eve-pr3-* QA headers.
# Forbidden in NODE_ENV=production by server auth guard.
NEXT_PUBLIC_EVE_PR3_LOCAL_QA=false

# Persistence adapter.
# - postgres: clean PR3 PostgreSQL/Supabase target only (default when unset)
# - memory_qa: non-production transport/idempotency QA only; never real pilot evidence
EVE_PR3_PERSISTENCE_MODE=postgres
EVE_PR3_DATABASE_URL=
EVE_PR3_EXPECTED_PROJECT_REF=keqrkyumfyhfivllvdbl

# BFF action-token signature. Server-only, >=32 characters.
EVE_PR3_ACTION_TOKEN_SECRET=

# Clean pilot auth.
# Production P4 mode: supabase_user, verified against the clean project.
# QA modes:
# - disabled: fail closed (recommended until clean browser auth binding is approved)
# - local_test: non-production QA only
# - static_bearer: non-production controlled integration test only
EVE_PR3_PILOT_AUTH_MODE=supabase_user
EVE_PR3_PILOT_BEARER_TOKEN=
EVE_PR3_PILOT_PRINCIPAL_REF=
EVE_PR3_PILOT_SCOPE_REF=
EVE_PR3_PILOT_ACTIVITY_REF=

# Runtime adapter.
# - blocked: fail closed; production default until promoted B0→B2 adapter is deployed
# - synthetic_qa: non-production transport/idempotency/reentry QA only
EVE_PR3_RUNTIME_ADAPTER=blocked

# A08 B0 production AI adapter. Server-only; never expose through NEXT_PUBLIC_.
# Provider/model/profile are pinned by A08; P3 must qualify the observed production model/configuration.
EVE_PR3_OPENAI_API_KEY=
