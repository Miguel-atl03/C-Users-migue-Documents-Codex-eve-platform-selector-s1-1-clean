{
  "rule_id": "CAUSAL-20",
  "name": "Regla Operativa de Suficiencia Sistémica — 20 Preguntas Causales",
  "version": "1.0.0",
  "scope": "activity_runtime_run",
  "applies_to": "toda actividad primaria después de procesar bases fuente",
