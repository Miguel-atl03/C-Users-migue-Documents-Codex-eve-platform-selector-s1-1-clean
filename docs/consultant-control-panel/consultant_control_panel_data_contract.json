{
  "contract_id": "eve_consultant_control_panel_data_contract_v1",
  "contract_version": "1.0",
  "surface": "consultant_internal",
  "client_access": "blocked",
  "mode": "read_only",
  "capabilities": {
    "read": true,
    "manual_actions": {
      "enabled": false,
      "reason_code": "AUDITED_ENDPOINT_NOT_AVAILABLE"
