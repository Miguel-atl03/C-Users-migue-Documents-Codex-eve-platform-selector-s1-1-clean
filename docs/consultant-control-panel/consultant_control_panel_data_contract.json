    "downloads": {
      "enabled": false,
      "reason_code": "AUTHORIZED_GENERATOR_NOT_AVAILABLE"
    }
  },
  "envelope_fields": ["request_id", "generated_at", "contract_version", "data", "meta", "errors"],
  "bff_base": "/api/eve/consultant/control-panel",
  "endpoints": {
    "state": { "method": "GET", "path": "/state" },
    "client_company_progress": { "method": "GET", "path": "/client-company-progress" },
    "user_functional_help": { "method": "GET", "path": "/user-functional-help" },
    "operational_trace": { "method": "GET", "path": "/operational-trace" },
    "downloads": { "method": "GET", "path": "/downloads" },
    "manual_action": { "method": "POST", "path": "/manual-action", "status": "stub_disabled" },
    "download_request": { "method": "POST", "path": "/download-request", "status": "stub_disabled" }
  },
  "filters": [
    "client_company_id",
    "case_id",
    "user_id",
    "role_id",
    "role_runtime_session_id",
    "activity_id",
    "run_id",
    "event_type",
    "gate_code",
    "status",
    "view"
