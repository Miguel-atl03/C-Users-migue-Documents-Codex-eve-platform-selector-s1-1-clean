  "budget_rules_literal": [
    {
      "row": 2,
      "rule_id": "BR-001",
      "signal": "Objeto, sujeto, acción o estado ambiguo en B2",
      "action": "Abrir Semantic_Resolution_Gate y causales B2 antes de proyectar MoC/OLC."
    },
    {
      "row": 3,
      "rule_id": "BR-002",
      "signal": "Falla de transformación, duplicado, cancelación tardía, cambio no registrado",
      "action": "Abrir ruta 2.9/2.10 y cerrar transformation_exception_exists."
    },
    {
      "row": 4,
      "rule_id": "BR-003",
      "signal": "Entrega fallida o aceptación con observaciones en B3-Q22",
      "action": "Abrir C09; no cerrar receiver_feedback desde satisfacción."
    },
    {
      "row": 5,
      "rule_id": "BR-004",
      "signal": "Espera fuerte, fecha/hora que obliga, bloqueo o deadlock",
      "action": "Abrir C11 y Process_State_Timer_Gate."
    },
    {
      "row": 6,
      "rule_id": "BR-005",
      "signal": "Loop/rework recurrente",
      "action": "Abrir causal de loop/condición de salida; validar PF↔OLC."
    },
    {
      "row": 7,
      "rule_id": "BR-006",
      "signal": "Capacidad real menor que exigencia",
      "action": "Abrir causal B5/B6 sobre sacrificio, variedad residual y sostenibilidad."
    },
    {
      "row": 8,
      "rule_id": "BR-007",
      "signal": "Workaround o regla informal",
      "action": "Abrir causal B6; registrar como práctica observable, no juicio moral."
    },
    {
      "row": 9,
      "rule_id": "BR-008",
      "signal": "Baja confianza, señales cruzadas o tensión interpersonal ambigua en B7",
      "action": "Abrir C20 solo si B7-Q39/Q40 no resolvieron; no diagnosticar."
    },
    {
      "row": 10,
      "rule_id": "BR-009",
      "signal": "Presupuesto causal agotado",
      "action": "Priorizar rutas críticas B0/B2/B3/B7, luego Process State/timer, luego semantic resolution."
    },
    {
      "row": 11,
      "rule_id": "BR-010",
      "signal": "Pregunta compuesta",
      "action": "Contar como 1 interacción, pero dividir UI en subcampos y persistir separadamente."
    },
    {
      "row": 13,
      "rule_id": "Peso",
      "signal": "Señal",
      "action": "Uso"
    },
    {
      "row": 14,
      "rule_id": "5",
      "signal": "Variable canónica bloqueante unresolved",
      "action": "Abrir causal o reentry antes de continuar."
    },
    {
      "row": 15,
      "rule_id": "5",
      "signal": "Contradicción entre bloques",
      "action": "Prioridad sobre curiosidad analítica."
    },
    {
      "row": 16,
      "rule_id": "5",
      "signal": "Falta objeto/estado para PF u OLC",
      "action": "Activar semantic resolution."
    },
    {
      "row": 17,
      "rule_id": "4",
      "signal": "Deadlock o espera sin evento/timer",
      "action": "Activar Process_State_Timer_Gate."
    },
    {
      "row": 18,
      "rule_id": "4",
      "signal": "Feedback operativo del receptor",
      "action": "Activar C09."
    },
    {
      "row": 19,
      "rule_id": "4",
      "signal": "Retrabajo recurrente",
      "action": "Activar ruta loop/rework."
    },
    {
      "row": 20,
      "rule_id": "4",
      "signal": "Workaround informal",
      "action": "Activar Bloque 6 causal."
    },
    {
      "row": 21,
      "rule_id": "3",
      "signal": "Brecha capacidad real vs nominal",
      "action": "Activar B5/B6 si hay presupuesto."
    },
    {
      "row": 22,
      "rule_id": "3",
      "signal": "Diferencia real vs oficial",
      "action": "Activar conformance/reentry."
    },
    {
      "row": 23,
      "rule_id": "2",
      "signal": "Baja confianza semántica",
      "action": "Microconfirmación si afecta ruta."
    },
    {
      "row": 24,
      "rule_id": "0",
      "signal": "Curiosidad analítica sin impacto estructural",
      "action": "No abrir causal."
    }
