{
    "instruction":  "045-R2A",
    "classification":  "client_boundary_minimal_field_gap",
    "principle":  "Gaby must send user answer values plus server-issued opaque references only. It must not author catalog, lineage, source_trace, provenance, or semantic Runtime identity.",
