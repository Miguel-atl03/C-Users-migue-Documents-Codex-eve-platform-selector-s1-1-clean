                                ],
    "client_must_not_send_as_authority":  [
                                              "catalog_version_id",
                                              "source_trace",
                                              "provenance_type",
                                              "source_node_id",
                                              "source_code",
                                              "capture_slot_kind",
                                              "tenant_id",
                                              "organization_id",
                                              "case_id",
                                              "response_revision_number"
                                          ],
    "current_live_payload":  [
                                 "sessionId",
                                 "sceneId",
                                 "answers[].questionCode",
                                 "answers[].blockId",
                                 "answers[].selectedValue",
                                 "answers[].selectedValues",
                                 "answers[].freeText",
                                 "answers[].answerNature",
                                 "answers[].canonicalVariable"
                             ],
    "current_gap":  "The live payload lacks a server-issued opaque Runtime run/interaction/slot reference. questionCode is a legacy catalog key, not a governed Runtime slot identity."
