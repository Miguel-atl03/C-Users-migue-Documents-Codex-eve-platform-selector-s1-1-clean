# EVE staging local development configuration.
# Copy to .env.local and fill the server-only secret locally.
#
# Legacy settings require explicit configuration and are not a PR3 baseline.
# Use .env.pr3.example for the standalone clean PR3 pilot.

# Browser-safe public configuration. These values are intended for the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase secret for BFF reads/mutations that require privileged
# access. Never prefix this with NEXT_PUBLIC_ and never commit .env.local.
# Use exactly one accepted variable name:
STAGING_SUPABASE_SECRET_KEY=
# EVE_SUPABASE_LOCAL_SERVICE_ROLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PRIVATE_SUPABASE_SERVICE_ROLE_KEY=

# Fixed staging consultant used for local E2E panel access.
NEXT_PUBLIC_EVE_PANEL_ACCESS_EMAIL=eve.controlpanel1@gmail.com
