{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eve.local/schemas/parallel-production/structural-fact.schema.json",
  "title": "EVE Capa 1 Parallel Production Structural Fact",
  "type": "object",
  "required": [
    "fact_id",
    "client_id",
    "session_id",
    "scene_id",
    "source_user_role",
    "block_origin",
    "question_origin",
    "literal_evidence",
    "normalized_fact_type",
    "canonical_label",
    "quadrant_targets",
    "source_candidate_ids",
    "source_evidence_ids",
    "confidence",
    "conformance_status",
    "consistency_status",
    "projection_status",
    "flags",
    "gaps",
    "boundaries"
  ],
  "properties": {
    "fact_id": { "type": "string", "minLength": 1 },
    "client_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "scene_id": { "type": "string", "minLength": 1 },
    "source_user_id": { "type": "string" },
    "source_user_role": { "type": "string", "minLength": 1 },
    "block_origin": { "type": "string", "pattern": "^block_" },
    "question_origin": { "type": "string", "minLength": 1 },
    "literal_evidence": { "type": "string", "minLength": 1 },
    "normalized_fact_type": {
      "enum": [
        "business_process",
        "business_function",
        "trigger_event",
        "target_state",
        "object_class",
        "attribute",
        "operation",
        "relationship",
        "object_state",
        "transition",
        "self_loop",
        "task",
        "process_state",
        "timer_event",
        "gateway",
        "handoff",
        "support_process",
        "workaround",
        "capacity_constraint",
        "consistency_flag",
        "reentry_gap"
      ]
    },
    "canonical_label": { "type": "string", "minLength": 1 },
    "quadrant_targets": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["PM", "PF", "MoC", "OLC"] },
      "uniqueItems": true
    },
    "source_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "related_process": { "type": ["string", "null"] },
    "related_object_class": { "type": ["string", "null"] },
    "related_object_state": { "type": ["string", "null"] },
    "related_event": { "type": ["string", "null"] },
    "related_operation": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "conformance_status": {
      "enum": [
        "pending",
        "conformant",
        "conformant_with_flags",
        "non_conformant",
        "insufficient_evidence",
        "requires_reentry"
      ]
    },
    "consistency_status": {
      "enum": [
        "pending",
        "consistent",
        "consistent_with_flags",
        "inconsistent",
        "unresolved",
        "requires_reentry"
      ]
    },
    "projection_status": {
      "enum": [
        "candidate",
        "accepted",
        "blocked",
        "requires_review"
      ]
    },
    "flags": { "type": "array" },
    "gaps": { "type": "array" },
    "boundaries": {
      "type": "object",
      "required": [
        "not_diagnostic",
        "not_capa2_readiness",
        "not_monetization",
        "not_final_narrative"
      ],
      "properties": {
        "not_diagnostic": { "const": true },
        "not_capa2_readiness": { "const": true },
        "not_monetization": { "const": true },
        "not_final_narrative": { "const": true }
      }
    },
    "design_gap_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional references to design-gap.schema.json gap_id values."
    }
  },
  "additionalProperties": true
}
