{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PF-SUP-04 PeliculaCausalAgregada Contract",
  "type": "object",
  "required": [
    "id",
    "case_id",
    "state",
    "source_ref",
    "derivation_ref",
    "governance_issue_refs",
    "readiness_decision_ref",
    "allowed_consumers",
    "forbidden_consumers",
    "audit_log"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "scenes_received",
        "aggregation_eligible",
        "index_built",
        "pattern_identified",
        "loss_estimated",
        "composed",
        "aggregated",
        "blocked_by_insufficient_scenes",
        "manual_review_required",
        "superseded",
        "archived"
      ]
    },
    "source_ref": {
      "type": "string"
    },
    "derivation_ref": {
      "type": "string"
    },
    "governance_issue_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readiness_decision_ref": {
      "type": "string"
    },
    "allowed_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_log": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "implementation_allowed": {
      "type": "boolean",
      "const": false
    },
    "materiality_level": {
      "type": "string",
      "enum": [
        "L0 absent",
        "L1 documented_only",
        "L2 vocabulary_only",
        "L3 guardrail_only",
        "L4 contract_defined",
        "L5 schema_present",
        "L6 service_present",
        "L7 tested_materiality",
        "L8 executable_materiality"
      ],
      "const": "L4 contract_defined"
    },
    "materiality_rationale": {
      "type": "string"
    },
    "pelicula_id": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number",
        "null"
      ]
    },
    "scene_set_ref": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number",
        "null"
      ]
    },
    "aggregation_index_ref": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number",
        "null"
      ]
    },
    "pattern_refs": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number",
        "null"
      ]
    },
    "monetizable_signal_refs": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number",
        "null"
      ]
    },
    "loss_estimate_refs": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number",
        "null"
      ]
    },
    "ahe_blockage_refs": {
      "type": [
        "string",
        "array",
        "object",
        "boolean",
        "number",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
