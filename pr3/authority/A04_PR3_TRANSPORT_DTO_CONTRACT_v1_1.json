      }
    },
    "ActionTokenResponse": {
      "required": [
        "command_receipt",
        "client_event_id",
        "operation",
        "issued_at",
        "expires_at",
        "action_token"
      ],
      "properties": {
        "client_event_id": "string opaque",
        "operation": "string",
